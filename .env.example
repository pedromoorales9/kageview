# ───────────────────────────────────────────────────────────
# Identificación OAuth de la app ante AniList (Implicit Grant)
#
# Copia este archivo a `.env` y rellena ANILIST_CLIENT_ID.
# `.env` NO se versiona (.gitignore) y persiste entre updates.
#
# Crea la app en: https://anilist.co/settings/developer
#   - Name: KageView (o el que quieras)
#   - Redirect URL: kageview://auth
#
# Con Implicit Grant SOLO se necesita el clientId, que es PÚBLICO
# (aparece en la URL de login). No es tu cuenta ni un secreto: es el
# identificador de la app para que cada usuario entre con SU cuenta.
# El client_secret NO se usa ni se incrusta en el build.
# ───────────────────────────────────────────────────────────

ANILIST_CLIENT_ID=0

# Opcional / no usado con Implicit Grant:
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=kageview://auth

# ───────────────────────────────────────────────────────────
# Discord Rich Presence (opcional)
#
# Application ID de una app de Discord (https://discord.com/developers).
# Con él, KageView muestra en tu perfil de Discord el anime y episodio
# que estás viendo. Si se deja vacío, la función queda desactivada
# (todas las llamadas son no-ops silenciosos).
# ───────────────────────────────────────────────────────────

DISCORD_CLIENT_ID=
